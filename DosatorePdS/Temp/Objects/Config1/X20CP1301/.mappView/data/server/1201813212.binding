<Target xsi:type="brease" refId="mobileRecipe_TableItem1" attribute="stringValue" />
</Binding><Binding mode="oneWay">
<Source xsi:type="opcUa" refId="::Recipe:UIConnect.Recipe.List.Names" attribute="editable" />
<Target xsi:type="brease" refId="mobileRecipe_TableItem1" attribute="editable::stringValue" />
</Binding></Content>



<Content id="mobileRecipe"><Binding mode="twoWay">
<Source xsi:type="opcUa" refId="::Recipe:UIConnect.Recipe.Load" attribute="value" />
<Target xsi:type="brease" refId="mobileRecipe_MomentaryPushButton2" attribute="value" />
</Binding><Binding mode="oneWay">
<Source xsi:type="opcUa" refId="::Recipe:UIConnect.Recipe.Load" attribute="editable" />
<Target xsi:type="brease" refId="mobileRecipe_MomentaryPushButton2" attribute="editable::value" />
</Binding></Content>




<Content id="mobileRecipe"><Binding mode="twoWay">
<Source xsi:type="opcUa" refId="::Recipe:UIConnect.New.FileName" attribute="value" />
